// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id     String @id @default(uuid())
  name   String @unique // admin, editor, author, buyer
  users  User[]
  access Json?

  @@map("roles")
}

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  password      String
  profile_image String?
  bio           String?  @db.Text
  role_id       String
  role          Role     @relation(fields: [role_id], references: [id])
  status        String? // active, suspended
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_verified   Boolean  @default(false)
  two_factor_secret  String?
  two_factor_enabled Boolean @default(false)

  units           Unit[]
  project_updates ProjectUpdate[]
  blogs           Blog[]
  history         History[]

  @@map("users")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String   @unique
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("password_reset_tokens")
}

model Project {
  id                  String    @id @default(uuid())
  title               String
  slug                String    @unique
  location            String?
  type                String? // residential, commercial, mixed
  status              String? // upcoming, ongoing, completed
  start_date          DateTime? @db.Date
  expected_completion DateTime? @db.Date
  total_units         Int?
  hero_image          String?
  description         String?   @db.Text
  meta_title          String?
  meta_description    String?   @db.Text
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  units           Unit[]
  project_updates ProjectUpdate[]

  @@map("projects")
}

model Unit {
  id          String    @id @default(uuid())
  project_id  String
  project     Project   @relation(fields: [project_id], references: [id])
  unit_number String
  type        String? // apartment, shop
  floor       String?
  size_sqft   Float?
  price       Decimal?
  status      String? // available, booked, sold
  owner_id    String?
  owner       User?     @relation(fields: [owner_id], references: [id])
  created_at  DateTime  @default(now())
  inquiries   Inquiry[]

  @@map("units")
}

model ProjectUpdate {
  id                  String   @id @default(uuid())
  project_id          String
  project             Project  @relation(fields: [project_id], references: [id])
  title               String
  description         String?  @db.Text
  progress_percentage Int? // 0 - 100
  visibility          String? // public, private
  created_by          String
  creator             User     @relation(fields: [created_by], references: [id])
  created_at          DateTime @default(now())

  images ProjectUpdateImage[]

  @@map("project_updates")
}

model ProjectUpdateImage {
  id        String        @id @default(uuid())
  update_id String
  update    ProjectUpdate @relation(fields: [update_id], references: [id])
  image_url String

  @@map("project_update_images")
}

model Blog {
  id                String       @id @default(uuid())
  title             String
  slug              String       @unique
  short_description String?      @db.Text
  content           String?      @db.Text
  meta_title        String?
  meta_description  String?      @db.Text
  hero_image        String?
  status            String? // draft, published
  faqs              String?      @db.Text
  author_id         String
  author            User         @relation(fields: [author_id], references: [id])
  category_id       String
  category          BlogCategory @relation(fields: [category_id], references: [id])
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  published_at      DateTime?

  tags BlogTag[]

  @@map("blogs")
}

model BlogCategory {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  blogs  Blog[]
  system Boolean @default(false)

  @@map("blog_categories")
}

model Tag {
  id    String    @id @default(uuid())
  name  String
  slug  String    @unique
  blogs BlogTag[]

  @@map("tags")
}

model BlogTag {
  id      String @id @default(uuid())
  blog_id String
  blog    Blog   @relation(fields: [blog_id], references: [id])
  tag_id  String
  tag     Tag    @relation(fields: [tag_id], references: [id])

  @@unique([blog_id, tag_id])
  @@map("blog_tags")
}

model Page {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  template         String?  @default("default") // home, contact, careers, policy, journal, default
  content          String?  @db.Text
  meta_title       String?
  meta_description String?  @db.Text
  og_title         String?
  og_description   String?  @db.Text
  og_image         String?
  status           String? // draft, published
  faqs             String?  @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("pages")
}

model History {
  id          String   @id @default(uuid())
  entity_type String // project, unit, blog, page, user, update
  entity_id   String
  field_name  String
  old_value   String?  @db.Text
  new_value   String?  @db.Text
  changed_by  String
  user        User     @relation(fields: [changed_by], references: [id])
  created_at  DateTime @default(now())

  @@map("history")
}

model Inquiry {
  id             String    @id @default(uuid())
  name           String
  phone          String
  email          String
  preferred_date DateTime? @db.Date
  message        String?   @db.Text
  unit_id        String?
  unit           Unit?     @relation(fields: [unit_id], references: [id])
  status         String    @default("new") // new, contacted, closed
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@map("inquiries")
}

model AnalyticsSession {
  id           String              @id @default(uuid())
  visitorId    String // Hashed IP or Fingerprint
  userAgent    String?             @db.Text
  device       String? // mobile, desktop, tablet
  browser      String?
  os           String?
  referrer     String?             @db.Text
  country      String?
  city         String?
  duration     Int                 @default(0) // in seconds
  pageViews    Int                 @default(1)
  isConversion Boolean             @default(false)
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt
  page_views   AnalyticsPageView[]
  events       AnalyticsEvent[]

  @@map("analytics_sessions")
}

model AnalyticsPageView {
  id         String           @id @default(uuid())
  sessionId  String
  session    AnalyticsSession @relation(fields: [sessionId], references: [id])
  url        String           @db.Text
  title      String?          @db.Text
  duration   Int              @default(0) // seconds spent on this page
  created_at DateTime         @default(now())

  @@map("analytics_page_views")
}

model AnalyticsEvent {
  id         String           @id @default(uuid())
  sessionId  String
  session    AnalyticsSession @relation(fields: [sessionId], references: [id])
  type       String // 'click', 'form_submission', etc.
  name       String // 'contact_form', 'download_pdf', etc.
  metadata   Json?
  created_at DateTime         @default(now())

  @@map("analytics_events")
}
